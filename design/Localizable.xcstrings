    "Sustained write speed dropped %lld%% from its peak.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续写入速度从峰值下降了 %lld%%。"
          }
        }
      }
    },
    "The drive reached %lld°C — thermal throttling is the likely cause.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "硬盘温度达到 %lld°C——很可能是过热降频导致。"
          }
        }
      }
    },
    "Temperature stayed moderate, so this is most likely the SLC write cache filling up.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温度保持平稳,因此很可能是 SLC 写入缓存被填满导致。"
          }
        }
      }
    },
    "This drive has no writable volume to test on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该硬盘没有可写入的卷,无法测速。"
          }
        }
      }
    },
    "Not enough free space on this drive for the selected test size.": {
      "localizations": {
        "zh-Hans": {
